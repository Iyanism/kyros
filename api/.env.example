# --- Required ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kyros
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kyros_test
ACCESS_TOKEN_SECRET_KEY=change-me-32+-char-random-string
REFRESH_TOKEN_SECRET_KEY=change-me-a-different-32+-char-random-string

# --- Optional (defaults shown) ---
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Facility identity + billing rates used by invoice computation
FACILITY_NAME=Cold Chain Facility Pvt Ltd
FACILITY_ADDRESS=Plot 7, Logistics Park, Bhiwandi 421302
FACILITY_GSTIN=27AAACF0000F1Z2
FACILITY_STATE=Maharashtra
STORAGE_DAILY_RATE_MT=50.0
HANDLING_RATE_MT=25.0
CGST_RATE=9.0
SGST_RATE=9.0
IGST_RATE=18.0
